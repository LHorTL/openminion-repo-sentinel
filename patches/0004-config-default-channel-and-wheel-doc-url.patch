Subject: [PATCH 4/5] fix(config): default AgentProfileConfig.default_channel to console and replace dead wheel doc links

1. Programmatic OpenMinionConfig.from_dict({"agents": {"openminion": {"provider": "openai"}}})
   + APIRuntime.from_config(...) left default_channel="" and crashed on turn 1 with
   `RuntimeError: inbound authenticity denied (reason=invalid_channel, mode=warn)`.
   Aligning programmatic defaults with `openminion config init` ("console") fixes this.
2. Replaces repo-relative `docs/reference/config-shape-migration-2026.md` (not shipped
   in the PyPI wheel) with hosted docs URL + actionable hint.
diff --git a/src/openminion/base/config/core.py b/src/openminion/base/config/core.py
--- a/src/openminion/base/config/core.py
+++ b/src/openminion/base/config/core.py
@@ -121,7 +121,7 @@
 
     name: str = ""
     role: str = ""
-    default_channel: str = ""
+    default_channel: str = "console"
     thinking: str = ""
     provider: str = ""
     default_act_profile: str = ""
@@ -344,8 +344,10 @@
     if not config.agents:
         raise ConfigValidationError(
             "OpenMinionConfig.agents is empty; no default agent is available. "
-            "Post-CSC configs must populate the 'agents' catalog. "
-            "See docs/reference/config-shape-migration-2026.md."
+            "Post-CSC configs must populate the 'agents' catalog (for example "
+            '{"agents": {"openminion": {"provider": "echo", "default_channel": "console"}}} '
+            "or run `openminion config init`). "
+            "See https://www.openminion.com/docs/."
         )
     if len(config.agents) == 1:
         return next(iter(config.agents))
@@ -397,8 +399,8 @@
     if not config.agents:
         raise UnknownProfileError(
             "No agent profiles are configured; post-CSC configs must populate "
-            "the 'agents' catalog. "
-            "See docs/reference/config-shape-migration-2026.md."
+            "the 'agents' catalog (run `openminion config init`). "
+            "See https://www.openminion.com/docs/."
         )
 
     if requested_agent_id:
