diff --git a/src/openminion/api/handoff.py b/src/openminion/api/handoff.py
--- a/src/openminion/api/handoff.py
+++ b/src/openminion/api/handoff.py
@@ -166,7 +166,25 @@
     description = handoff.resolved_description()
 
     def _handler_fn(message: str) -> dict[str, Any]:
-        result = handoff.target.run(message)
+        from openminion.api.agent import _ACTIVE_TURN_HOOKS
+
+        hooks = _ACTIVE_TURN_HOOKS.get() or {}
+        on_delta = hooks.get("on_delta")
+        if on_delta is not None:
+            result = handoff.target.run_stream(
+                message,
+                on_delta=on_delta,
+                timeout_seconds=hooks.get("timeout_seconds"),
+                approval_callback=hooks.get("approval_callback"),
+                cancel_event=hooks.get("cancel_event"),
+            )
+        else:
+            result = handoff.target.run(
+                message,
+                timeout_seconds=hooks.get("timeout_seconds"),
+                approval_callback=hooks.get("approval_callback"),
+                cancel_event=hooks.get("cancel_event"),
+            )
         raw_output = result.output
