Subject: [PATCH 3/5] fix(policy): skip POSIX S_IWOTH world-writable check on Windows

On Windows, CPython synthesizes st_mode=0o666/0o777 from the DOS read-only bit
rather than NTFS ACLs, causing `openminion doctor` to emit 3 false-positive
world-writable warnings recommending Unix `chmod 750 / 640` on every fresh install.
diff --git a/src/openminion/modules/policy/diagnostics/security.py b/src/openminion/modules/policy/diagnostics/security.py
--- a/src/openminion/modules/policy/diagnostics/security.py
+++ b/src/openminion/modules/policy/diagnostics/security.py
@@ -1,3 +1,4 @@
+import os
 import stat
 from collections.abc import Sequence
 from dataclasses import dataclass
@@ -374,6 +375,14 @@
             severity=SEVERITY_INFO,
             message=missing_message,
             details={"path": str(path)},
+        )
+
+    if os.name == "nt":
+        return SecurityValidateFinding(
+            id=check_id,
+            severity=SEVERITY_INFO,
+            message=f"POSIX mode-bit permission check skipped on Windows (NTFS ACLs apply): {path}",
+            details={"path": str(path), "platform": "nt"},
         )
 
     mode = path.stat().st_mode
